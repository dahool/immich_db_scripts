-- Table: public.albums_persons

-- DROP TABLE IF EXISTS public.albums_persons;

CREATE TABLE IF NOT EXISTS public.albums_persons
(
    "albumId" uuid NOT NULL,
    "personId" uuid NOT NULL,
    "ownerId" uuid,
    CONSTRAINT fk_albums FOREIGN KEY ("albumId")
        REFERENCES public.album (id) MATCH SIMPLE
        ON UPDATE CASCADE
        ON DELETE CASCADE,
    CONSTRAINT fk_person_group FOREIGN KEY ("ownerId", "personId")
        REFERENCES public.person ("ownerId", "personGroupId") MATCH SIMPLE
        ON UPDATE NO ACTION
        ON DELETE NO ACTION
)

TABLESPACE pg_default;

ALTER TABLE IF EXISTS public.albums_persons
    OWNER to postgres;

GRANT ALL ON TABLE public.albums_persons TO postgres;

-- Drop the existing restriction constraint
ALTER TABLE public.albums_persons 
DROP CONSTRAINT fk_person_group;

-- Recreate it with CASCADE delete enabled
ALTER TABLE public.albums_persons 
ADD CONSTRAINT fk_person_group 
FOREIGN KEY ("ownerId", "personId")
REFERENCES public.person ("ownerId", "personGroupId") 
MATCH SIMPLE
ON UPDATE NO ACTION
ON DELETE CASCADE;

ALTER TABLE public.albums_persons
    ALTER COLUMN "ownerId" SET NOT NULL;

CREATE UNIQUE INDEX IF NOT EXISTS albums_persons_album_owner_person_uidx
    ON public.albums_persons ("albumId", "ownerId", "personId");